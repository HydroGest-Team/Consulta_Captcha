set -e

MAVEN_VERSION="3.9.6"
MAVEN_HOME="${HOME}/.m2/wrapper/dists/apache-maven-${MAVEN_VERSION}-bin"
WRAPPER_JAR="${MAVEN_HOME}/maven-wrapper.jar"
WRAPPER_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar"

if [ ! -f "${WRAPPER_JAR}" ]; then
    mkdir -p "${MAVEN_HOME}"
    echo "Downloading Maven Wrapper..."
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "${WRAPPER_URL}" -o "${WRAPPER_JAR}"
    elif command -v wget >/dev/null 2>&1; then
        wget -q "${WRAPPER_URL}" -O "${WRAPPER_JAR}"
    else
        echo "Error: curl or wget required to download Maven Wrapper"
        exit 1
    fi
fi

exec java -cp "${WRAPPER_JAR}" org.apache.maven.wrapper.MavenWrapperMain "$@"