        </mxCell>
        <mxCell id="m1v3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="&lt;b&gt;Cliente final&lt;/b&gt;&lt;br&gt;Navegador · sin login" vertex="1">
          <mxGeometry height="70" width="180" x="27" y="275" as="geometry" />
        </mxCell>
        <mxCell id="m1v4" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffde7;strokeColor=#bfa600;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;• El navegador solo llama a &lt;b&gt;/api/consulta&lt;/b&gt;; nunca al puerto 8081.&lt;br&gt;• La llave secreta del captcha vive solo en el servidor de Next.js.&lt;br&gt;• Respuesta 200: JSON &lt;i&gt;EstadoCuenta&lt;/i&gt; (código, titular enmascarado, estado AL_DIA / PENDIENTE, saldo pendiente, última lectura, últimos 5 pagos).&lt;br&gt;• Errores: 400 formato o captcha inválido · 404 contador inexistente · 429 límite excedido · 502 servicio caído." vertex="1">
          <mxGeometry height="290" width="220" x="37" y="367.5" as="geometry" />
        </mxCell>
        <mxCell id="m1v5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f6ff;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;arcSize=4;" value="web-publica · Next.js 14 · :3000" vertex="1">
          <mxGeometry height="570" width="320" x="357" y="90" as="geometry" />
        </mxCell>
        <mxCell id="m1v6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;b&gt;app/page.tsx&lt;/b&gt;&lt;br&gt;inicio · botón &quot;Iniciar Consulta Pública&quot;" vertex="1">
          <mxGeometry height="60" width="250" x="392" y="130" as="geometry" />
        </mxCell>
        <mxCell id="m1v7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;b&gt;app/consulta/page.tsx&lt;/b&gt;&lt;br&gt;formulario: código del contador&lt;br&gt;+ widget reCAPTCHA v2&lt;br&gt;&lt;span style=&#39;font-size:10px&#39;&gt;(NEXT_PUBLIC_RECAPTCHA_SITE_KEY)&lt;/span&gt;&lt;br&gt;muestra tarjeta de estado o error" vertex="1">
          <mxGeometry height="115" width="250" x="392" y="252.5" as="geometry" />
        </mxCell>
        <mxCell id="m1v8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;b&gt;app/api/consulta/route.ts · BFF&lt;/b&gt;&lt;br&gt;&lt;div style=&#39;text-align:left;font-size:11px&#39;&gt;1. exige codigo y token → 400&lt;br&gt;2. valida ^[A-Z0-9_-]{1,20}$ → 400&lt;br&gt;3. verifica captcha con&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;RECAPTCHA_SECRET_KEY → 400&lt;br&gt;4. llama a CONSULTA_SERVICE_URL&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;reenviando X-Forwarded-For&lt;br&gt;5. traduce 200/400/404/429/502&lt;/div&gt;" vertex="1">
          <mxGeometry height="195" width="250" x="392" y="440" as="geometry" />
        </mxCell>
        <mxCell id="m1v9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f6ff;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;arcSize=4;" value="consulta-service · Spring Boot 3.3 · Java 21 · :8081" vertex="1">
          <mxGeometry height="590" width="746" x="821" y="90" as="geometry" />
