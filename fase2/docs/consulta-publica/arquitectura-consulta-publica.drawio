        <mxCell id="m1v10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="&lt;b&gt;RateLimitInterceptor&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px&#39;&gt;registrado en WebConfig para /api/v1/consulta/**&lt;br&gt;ConcurrentHashMap por IP · 10 pet/min&lt;br&gt;excedido → 429 + Retry-After&lt;/span&gt;" vertex="1">
