        <mxCell id="m1v2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2D7FF9;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#2D7FF9;arcSize=2;" value="Docker Compose (local) — fase2/docker-compose.yml" vertex="1">
